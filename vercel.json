{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/source.ts": { "maxDuration": 60 },
    "api/source-browser.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/suwayomi/:path*", "destination": "/api/suwayomi?path=:path*" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-cache" },
      { "key": "Service-Worker-Allowed", "value": "/" }
    ] }
  ]
}
