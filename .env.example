# Development and npm start. Docker Compose overrides this with its service URL.
PORT=4173
SUWAYOMI_URL=http://127.0.0.1:4567

# Docker Compose: choose a password before starting the server.
SUWAYOMI_USERNAME=reader
SUWAYOMI_PASSWORD=
SUWAYOMI_EXTENSION_STORES=[]

# Optional public HTTPS profile: set a domain pointing to your Docker host.
# MIHON_DOMAIN=reader.example.com

# Optional dedicated browser backend, usable from a PWA without an iOS app.
# Both services must use the same random secret. Never put it in VITE_* vars.
SOURCE_BROWSER_URL=http://127.0.0.1:4190
SOURCE_BROWSER_TOKEN=
BROWSER_PORT=4190
BROWSER_HOST=127.0.0.1
# Browser processes close after this idle period; cookies are saved for 24h.
BROWSER_IDLE_MS=180000
