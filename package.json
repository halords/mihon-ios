{
  "name": "mihon-ios",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "start:browser": "node --env-file-if-exists=.env browser-server/index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:server": "vitest run --config vitest.server.config.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.4"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
